## Plays the workstation through the real scene by pressing its buttons.
extends "res://tests/ui_test_base.gd"


func test_t01_from_briefing_to_next_briefing() -> void:
	var desktop := _start()
	var log := DesktopSession.messenger_log()
	check(log["delivered"] > 0, "briefing delivered")
	check_eq(log["entries"][-1]["kind"], "ticket", "ticket card last")

	DesktopSession.open_app("messenger")
	check(press(desktop, "Open T01 in QA Tracker"), "ticket card button")
	check(DesktopSession.is_visible_app("tracker"), "tracker opened")
	check(press(desktop, "Start test"), "start test")
	check_eq(GameSession.ticket_status("T01"), "TESTING", "testing")
	check_eq(desktop.guide_step()["title"], "Open Shoply in the Browser.", "guide asks to open the site")

	check(press(desktop, "shoply.local/product/everyday-pack"), "tracker start link")
	check_eq(DesktopSession.location(), { "kind": "shoply", "path": "/shoply/product/everyday-pack" }, "browser location")
	check(press(desktop, "Add to bag"), "add to bag")
	check(press(desktop, "View bag"), "view bag")
	check(press(desktop, "Continue to checkout"), "checkout")
	var confirm: Node = find_named(desktop, "ConfirmOrder")
	check(confirm != null and confirm.get_meta("variant") == "secondary", "secondary CTA under the Mutation")
	check_eq(find_button(desktop, "Console ⚠ 1") != null, true, "console warns about the defect")
	check(press(desktop, "Console ⚠ 1"), "open console")
	check_eq(GameState.lead_terms(GameSession.state), ["release-bot", "02:14"], "console terms become leads")
	check(find_named(desktop, "Leadrelease-bot") != null, "lead is a search link")

	check(press(desktop, "🚩 Flag"), "flag")
	var evidence := WorkspaceSession.evidence_for("T01")
	check_eq(evidence.size(), 1, "flag captures the screen")
	var panel: Node = find_named(desktop, "FlagPanel")
	check(press(panel, "Confirm order button: Secondary action style"), "observation")
	check(press(panel, "final confirmation control", false), "requirement")
	check(press(panel, "Send flag"), "send")
	check_eq(GameSession.ticket_status("T01"), "RESOLVED", "resolved")
	check_eq(int(GameSession.state["profile"]["xp"]), 100, "xp")
	check_eq(GameSession.state["reportHistory"][-1]["severity"], "LOW", "severity filled in")

	check(press(desktop, "The team replied · Open Messenger"), "open messenger")
	check(DesktopSession.messenger_log()["pendingDiscovery"] != null, "debrief asks for a record")
	check_eq(desktop.guide_step()["label"], "Find the record", "guide points to search")
	check(press(find_named(desktop, "LeadSearch"), "🔎 release-bot"), "messenger offers the lead")
	check_eq(DesktopSession.location().get("query", ""), "release-bot", "lead searched")
	_find_record(desktop, "release-bot", "DOC-CHECKOUT-HISTORY")
	DesktopSession.open_app("messenger")
	check(DesktopSession.messenger_log()["pendingDeduction"] != null, "deduction pending")
	check(press(desktop, "designer changed the button", false), "wrong answer")
	check_eq(int(GameSession.state["profile"]["reputation"]), 102, "no penalty for a wrong guess")
	check(press(desktop, "automated merge modified it overnight", false), "right answer")
	var final_log := DesktopSession.messenger_log()
	check(final_log["pendingDeduction"] == null, "deduction solved")
	check_eq(final_log["entries"][-1]["ticketId"], "T02", "T02 briefing arrived")
	_finish()


func test_typed_addresses_docs_and_unknown_hosts() -> void:
	var desktop := _start()
	DesktopSession.open_app("browser")
	var address: LineEdit = find_named(desktop, "Address")
	address.text_submitted.emit("shoply.com")
	check(find_named(desktop, "BrowserApp") != null, "browser exists")
	check_eq(DesktopSession.location()["kind"], "unreachable", "unknown host")
	address.text_submitted.emit("docs.nothingwrong.local/checkout-interaction-specification")
	check_eq(DesktopSession.location()["kind"], "docs", "docs")
	check(find_button(desktop, "🚩 Flag").disabled, "flag needs an active ticket")
	address.text_submitted.emit("shoply.local")
	check_eq(DesktopSession.location()["path"], "/shoply", "shoply home")
	check(find_button(desktop, "View product →") != null, "storefront home lists products")
	DesktopSession.go_back()
	check_eq(DesktopSession.location()["kind"], "docs", "back")
	_finish()


func test_no_issue_found_on_a_defective_ticket_is_a_missed_bug() -> void:
	var desktop := _start()
	DesktopSession.show_ticket("T01")
	press(desktop, "Start test")
	DesktopSession.open_url("shoply.local")
	_no_issue(desktop)
	check_eq(GameSession.ticket_status("T01"), "TESTING", "still testing")
	check_eq(int(GameSession.state["profile"]["reputation"]), 99, "missed bug penalty")
	check(find_button(desktop, "Back to T01") != null, "invalid review offers a retry")
	_finish()


func test_full_chapter_one() -> void:
	var desktop := _start()
	_accept(desktop, "T01")
	_address(desktop, "shoply.local")
	press(desktop, "View product →")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	press(desktop, "Continue to checkout")
	_flag(desktop, "final confirmation control", "Confirm order button: Secondary action style")
	check(GameState.lead_terms(GameSession.state).has("release-bot"), "flagging notes the console lead")
	_find_record(desktop, "release-bot", "DOC-CHECKOUT-HISTORY")
	DesktopSession.open_app("messenger")
	press(desktop, "automated merge modified it overnight", false)

	_accept(desktop, "T02")
	_address(desktop, "shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	(find_named(desktop, "Quantity") as OptionButton).item_selected.emit(1)
	check_eq(ShoplyStore.item_count(), 2, "quantity two")
	_flag(desktop, "subtotal equals product price multiplied by quantity", "Subtotal: $50.00")
	var values: Array = WorkspaceSession.evidence_for("T02")[-1]["snapshot"]["controls"].map(func(control): return "%s: %s" % [control["label"], control["value"]])
	check(values.has("Subtotal: $50.00") and values.has("Line total: $60.00"), "T02 mutation captured: %s" % str(values))
	check_eq(GameSession.ticket_status("T02"), "RESOLVED", "T02 resolved")
	_find_record(desktop, "TWO_FOR_50", "DOC-PROMO-ARCHIVE")
	DesktopSession.open_app("messenger")
	press(desktop, "same overnight merge by release-bot", false)

	_accept(desktop, "T03")
	_address(desktop, "shoply.local/orders/order-1042")
	check(find_button(desktop, "Basic") == null, "no account switcher yet")
	check(press(desktop, "Console ⚠ 1"), "order screen logs the rewrite")
	check(GameState.lead_terms(GameSession.state).has("exp/retention-push"), "experiment lead")
	_find_record(desktop, "exp/retention-push", "DOC-EXPERIMENT")
	check_eq(GameSession.catalog.is_clue_found(GameSession.state, GameSession.scenario("T03")), false, "an early record waits for the flag")
	_address(desktop, "shoply.local/orders/order-1042")
	press(desktop, "Cancel order")
	check_eq(DesktopSession.location()["path"], "/shoply/payment", "cancel opens payment")
	_flag(desktop, "Cancel Order opens the return or cancellation flow", "Screen shown: Payment details")
	check_eq(GameSession.ticket_status("T03"), "RESOLVED", "T03 resolved")
	check(GameSession.catalog.is_clue_found(GameSession.state, GameSession.scenario("T03")), "early record connects once flagged")
	DesktopSession.open_app("messenger")
	press(desktop, "release-bot merged old, archived branches", false)

	_accept(desktop, "T04")
	_address(desktop, "shoply.local")
	press(desktop, "View product →")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	var coupon_field: LineEdit = find_named(desktop, "CouponCode")
	coupon_field.text = "SAVE20"
	coupon_field.text_submitted.emit("SAVE20")
	check_eq(ShoplyStore.coupon, "SAVE20", "coupon applied")
	check(press(desktop, "Gold"), "account switcher")
	(find_named(desktop, "Quantity") as OptionButton).item_selected.emit(2)
	_flag(desktop, "20% discount at every quantity", "Discount: −$9.00")
	var discount: Array = WorkspaceSession.evidence_for("T04")[-1]["snapshot"]["controls"].filter(func(control): return control["target"] == "cart.discount")
	check(not discount.is_empty() and discount[0]["value"] == "−$9.00", "T04 discount captured")
	check_eq(GameSession.ticket_status("T04"), "RESOLVED", "T04 resolved")
	_find_record(desktop, "merge rule", "DOC-BOT-CONFIG")
	DesktopSession.open_app("messenger")
	check(press(desktop, "Open Case File and connect the clues"), "messenger sends the player to the board")
	check(find_named(desktop, "ClueBoard") != null, "clue board shown")
	check(toggle_on(desktop, "02:14 · release-bot"), "pick the merge clue")
	check(toggle_on(desktop, "The widened merge rule"), "pick the rule clue")
	check(press(desktop, "widened merge rule made release-bot", false), "pick the conclusion")
	check(press(desktop, "Send to Maya Kim"), "send")
	var log := DesktopSession.messenger_log()
	check(log["entries"].any(func(entry): return entry.get("text", "") == "Chapter 1 · Release Candidate 3 complete."), "chapter finale")

	_accept(desktop, "T05")
	_address(desktop, "shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	check_eq(find_button(desktop, "Console", false).text, "Console", "a clean build logs no warnings")
	_no_issue(desktop)
	check_eq(GameSession.ticket_status("T05"), "RESOLVED", "clean build closed as NO ISSUE FOUND")
	_find_record(desktop, "access log", "DOC-ARCHIVE-ACCESS")
	check(GameSession.catalog.found_clues(GameSession.state, "CH2").size() == 1, "chapter 2 hook clue")

	check_eq(int(GameSession.state["profile"]["xp"]), 500, "xp")
	check_eq(int(GameSession.state["profile"]["reputation"]), 114, "reputation with four first-try deductions")
	DesktopSession.set_tracker_view("casefile")
	check(find_named(desktop, "CaseFile") != null, "case file renders")
	_finish()
