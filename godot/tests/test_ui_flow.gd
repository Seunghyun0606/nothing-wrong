## Plays the workstation through the real scene by pressing its buttons.
extends "res://tests/ui_test_base.gd"


func test_t01_from_briefing_to_next_briefing() -> void:
	var desktop := _start()
	var log := DesktopSession.messenger_log()
	check(log["delivered"] > 0, "briefing delivered")
	check_eq(log["entries"][-1]["kind"], "ticket", "ticket card last")

	DesktopSession.open_app("messenger")
	check(press(desktop, "Open T01 in QA Notes"), "ticket card button")
	check(DesktopSession.is_visible_app("notes"), "QA Notes opened")
	check(press(desktop, "Start test"), "start test")
	check_eq(GameSession.ticket_status("T01"), "TESTING", "testing")
	check(DesktopSession.messenger_log()["entries"].any(func(entry): return str(entry.get("text", "")).contains("📌 Note")), "Maya explains how to note and report")

	check(press(desktop, "shoply.local/product/everyday-pack"), "start link in QA Notes")
	check_eq(DesktopSession.location(), { "kind": "shoply", "path": "/shoply/product/everyday-pack" }, "browser location")
	check(press(desktop, "Add to bag"), "add to bag")
	check(press(desktop, "View bag"), "view bag")
	check(press(desktop, "Continue to checkout"), "checkout")
	var confirm: Node = find_named(desktop, "ConfirmOrder")
	check(confirm != null and confirm.get_meta("variant") == "secondary", "secondary CTA under the Mutation")
	check(find_button(desktop, "Console ⚠ 1", false) == null, "the console does not point at the defect")
	check(press(desktop, "Console"), "open console")
	var console_lines: Array = find_named(desktop, "Console").find_children("*", "Label", true, false).map(func(label): return label.text)
	check(console_lines.size() >= 5, "the trace sits among everyday log lines: %s" % str(console_lines))
	check(console_lines.any(func(text): return text.contains("release-bot")), "the trace is there to read")
	check(find_named(desktop, "Leadrelease-bot") == null, "nothing to click: the player types what they read")
	check_eq(GameState.lead_terms(GameSession.state), ["release-bot", "02:14"], "what the player saw is remembered")

	check(press(desktop, "📌 Note"), "note mode")
	check((find_named(desktop, "NoteBar") as Control).visible, "the page asks for a click")
	var marker: Node = find_named(desktop, "Markcheckout_confirmButton")
	check(marker != null, "the button is highlighted")
	if marker:
		marker.pressed.emit()
	var noted := WorkspaceSession.evidence_for("T01")
	check_eq(noted.size(), 1, "one note")
	check_eq(noted[0].get("focus", {}).get("value", ""), "Secondary action style", "the clicked part is noted")
	check(not (find_named(desktop, "NoteBar") as Control).visible, "noting ends after a click")
	check(find_named(desktop, "Noted") != null, "the note is in QA Notes")
	check(find_named(desktop, "Toasts").get_child_count() > 0, "a notification confirms the note")

	DesktopSession.open_app("messenger")
	check(press(desktop, "📝 Report T01 to Maya Kim"), "open the report form")
	var form: Node = find_named(desktop, "ReportComposer")
	check(press(form, "Confirm order button: Secondary action style", false), "pick the note")
	check(press(form, "final confirmation control", false), "pick the requirement")
	check(press(form, "Send report"), "send")
	check_eq(GameSession.ticket_status("T01"), "RESOLVED", "resolved")
	check_eq(GameSession.state["reportHistory"][-1]["severity"], "LOW", "severity filled in")
	check(DesktopSession.messenger_log()["entries"].any(func(entry): return entry["kind"] == "report"), "the report is in the chat")

	check(DesktopSession.messenger_log()["pendingDiscovery"] != null, "debrief asks for a record")
	check(find_named(desktop, "SearchHelp") == null, "no search terms handed out at first")
	var tabs_before := DesktopSession.tabs.size()
	check(press(find_named(desktop, "MessengerApp"), "Open intranet search"), "messenger opens the search")
	check_eq(DesktopSession.tabs.size(), tabs_before + 1, "the search opens in a new tab")
	check_eq(DesktopSession.tab_location(DesktopSession.active_tab - 1)["kind"], "shoply", "Shoply stays open in its tab")
	DesktopSession.search_intranet("banana")
	DesktopSession.search_intranet("lunch")
	check_eq(GameState.search_misses(GameSession.state, "DOC-CHECKOUT-HISTORY"), 2, "two searches missed the record")
	DesktopSession.open_app("messenger")
	check(press(find_named(desktop, "SearchHelp"), "🔎 release-bot"), "after two misses the team suggests a search")
	check_eq(DesktopSession.location().get("query", ""), "release-bot", "suggested search")
	_find_record(desktop, "release-bot", "DOC-CHECKOUT-HISTORY")
	DesktopSession.open_app("messenger")
	check(DesktopSession.messenger_log()["pendingDeduction"] != null, "deduction pending")
	_deduce(desktop, { "changed": "did change", "when": "18:40", "who": "release-bot" })
	var reply: Dictionary = DesktopSession.messenger_log()["entries"][-1]
	check_eq([reply["text"], reply["args"]], ["%d of %d parts hold up. Look at your clues again.", [2, 3]], "Maya says how many parts hold up")
	_deduce(desktop, { "changed": "did change", "when": "02:14", "who": "release-bot" })
	var final_log := DesktopSession.messenger_log()
	check(final_log["pendingDeduction"] == null, "deduction solved")
	check_eq(final_log["entries"][-1]["ticketId"], "T02", "T02 briefing arrived")
	_finish()


func test_t01_missed_reports_get_replies_and_the_team_steps_in() -> void:
	var desktop := _start()
	DesktopSession.open_app("messenger")
	DesktopSession.show_ticket("T01")
	press(desktop, "Start test")
	DesktopSession.open_url("shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")

	_note(desktop, "cart.subtotal")
	_report(desktop, "Subtotal", "final confirmation control")
	check_eq(GameSession.ticket_status("T01"), "TESTING", "a miss keeps testing")
	var tail: Array = DesktopSession.messenger_log()["entries"].slice(-3)
	check_eq(tail[0]["kind"], "report", "the report")
	check_eq([tail[1]["from"], tail[1]["text"]], ["Maya Kim", "I checked that screen and it matches the Ticket. The problem must be somewhere else on the path."], "Maya replies with where to look")
	check(str(tail[2]["id"]).ends_with(":assist:1"), "the first miss brings Maya's tip")

	DesktopSession.open_app("browser")
	check(press(desktop, "Continue to checkout"), "checkout")
	_note(desktop, "checkout.confirmButton")
	_report(desktop, "Confirm order button", "add a product to the cart")
	var entries: Array = DesktopSession.messenger_log()["entries"]
	check(str(entries[-2]["text"]).begins_with("That value is wrong"), "wrong rule reply")
	check(str(entries[-1]["id"]).ends_with(":assist:2"), "the answer arrives")

	_report(desktop, "Confirm order button", "final confirmation control")
	check_eq(GameSession.ticket_status("T01"), "RESOLVED", "resolved")
	_finish()


func test_browser_tabs_keep_their_own_pages() -> void:
	var desktop := _start()
	DesktopSession.open_url("shoply.local/cart")
	check_eq(DesktopSession.tabs.size(), 1, "a blank tab is reused")
	DesktopSession.search_intranet("release-bot")
	check_eq(DesktopSession.tabs.size(), 2, "a link from elsewhere opens a new tab")
	check(find_named(desktop, "Tab1") != null, "two tabs in the tab bar")
	check(press(find_named(desktop, "Tab0"), "Shoply /cart"), "switch back to the shop tab")
	check_eq(DesktopSession.location(), { "kind": "shoply", "path": "/shoply/cart" }, "the shop tab kept its page")
	DesktopSession.go_back()
	check_eq(DesktopSession.location()["kind"], "newtab", "each tab has its own history")
	check(press(desktop, "+"), "new tab")
	check_eq([DesktopSession.tabs.size(), DesktopSession.location()["kind"]], [3, "newtab"], "a blank tab")
	press(find_named(desktop, "Tab2"), "×")
	check_eq(DesktopSession.tabs.size(), 2, "closed")
	for index in 8:
		DesktopSession.open_tab()
	check_eq(DesktopSession.tabs.size(), DesktopSession.MAX_TABS, "the oldest tabs close past the limit")
	_finish()


func test_typed_addresses_docs_and_unknown_hosts() -> void:
	var desktop := _start()
	DesktopSession.open_app("browser")
	var address: LineEdit = find_named(desktop, "Address")
	address.text_submitted.emit("shoply.com")
	check(find_named(desktop, "BrowserApp") != null, "browser exists")
	check_eq(DesktopSession.location()["kind"], "unreachable", "unknown host")
	address.text_submitted.emit("docs.nothingwrong.local/checkout-interaction-specification")
	check_eq(DesktopSession.location()["kind"], "docs", "docs")
	check(find_button(desktop, "📌 Note").disabled, "noting needs an active ticket")
	address.text_submitted.emit("shoply.local")
	check_eq(DesktopSession.location()["path"], "/shoply", "shoply home")
	check(find_button(desktop, "View product →") != null, "storefront home lists products")
	DesktopSession.go_back()
	check_eq(DesktopSession.location()["kind"], "docs", "back")
	_finish()


func test_no_issue_found_on_a_defective_ticket_is_a_missed_bug() -> void:
	var desktop := _start()
	DesktopSession.show_ticket("T01")
	press(desktop, "Start test")
	DesktopSession.open_url("shoply.local")
	_no_issue(desktop)
	check_eq(GameSession.ticket_status("T01"), "TESTING", "still testing")
	var last: Dictionary = DesktopSession.messenger_log()["entries"][-2]
	check_eq(last["text"], "Are you sure? Something in this Ticket still breaks a requirement. Try other quantities, accounts, and actions.", "Maya pushes back")
	_finish()


func test_full_story() -> void:
	var desktop := _start()
	_accept(desktop, "T01")
	_address(desktop, "shoply.local")
	press(desktop, "View product →")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	press(desktop, "Continue to checkout")
	_note(desktop, "checkout.confirmButton")
	check(GameState.lead_terms(GameSession.state).has("release-bot"), "noting remembers the console")
	_report(desktop, "Confirm order button", "final confirmation control")
	_find_record(desktop, "release-bot", "DOC-CHECKOUT-HISTORY")
	DesktopSession.open_app("messenger")
	_deduce(desktop, { "changed": "did change", "when": "02:14", "who": "release-bot" })

	_accept(desktop, "T02")
	_address(desktop, "shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	(find_named(desktop, "Quantity") as OptionButton).item_selected.emit(1)
	check_eq(ShoplyStore.item_count(), 2, "quantity two")
	_note(desktop, "cart.subtotal")
	var values: Array = WorkspaceSession.evidence_for("T02")[-1]["snapshot"]["controls"].map(func(control): return "%s: %s" % [control["label"], control["value"]])
	check(values.has("Subtotal: $50.00") and values.has("Line total: $60.00"), "T02 mutation noted: %s" % str(values))
	_report(desktop, "Subtotal: $50.00", "subtotal equals product price multiplied by quantity")
	check_eq(GameSession.ticket_status("T02"), "RESOLVED", "T02 resolved")
	_find_record(desktop, "TWO_FOR_50", "DOC-PRICING-RULES")
	check(DesktopSession.messenger_log()["pendingDiscovery"] != null, "the rule registry is only a step")
	_find_record(desktop, "Spring Duo", "DOC-PROMO-ARCHIVE")
	DesktopSession.open_app("messenger")
	_deduce(desktop, { "what": "subtotal rule", "when": "02:14", "who": "release-bot" })

	_accept(desktop, "T03")
	_address(desktop, "shoply.local/orders/order-1042")
	check(find_button(desktop, "Basic") == null, "no account switcher yet")
	check(press(desktop, "Console"), "read the order screen's console")
	check(GameState.lead_terms(GameSession.state).has("exp/retention-push"), "experiment lead")
	_find_record(desktop, "exp/retention-push", "DOC-EXPERIMENT")
	check_eq(GameSession.catalog.is_clue_found(GameSession.state, GameSession.scenario("T03")), false, "an early record waits for the report")
	_address(desktop, "shoply.local/orders/order-1042")
	press(desktop, "Cancel order")
	check_eq(DesktopSession.location()["path"], "/shoply/payment", "cancel opens payment")
	_note(desktop, "payment.form")
	_report(desktop, "Screen shown", "Cancel Order opens the return or cancellation flow")
	check_eq(GameSession.ticket_status("T03"), "RESOLVED", "T03 resolved")
	check(GameSession.catalog.is_clue_found(GameSession.state, GameSession.scenario("T03")), "early record connects once reported")
	DesktopSession.open_app("messenger")
	_deduce(desktop, { "what": "archived branches", "flag": "exp/retention-push", "where": "the payment page" })

	_accept(desktop, "T04")
	_address(desktop, "shoply.local")
	press(desktop, "View product →")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	var coupon_field: LineEdit = find_named(desktop, "CouponCode")
	coupon_field.text = "SAVE20"
	coupon_field.text_submitted.emit("SAVE20")
	check_eq(ShoplyStore.coupon, "SAVE20", "coupon applied")
	check(press(desktop, "Gold"), "account switcher")
	(find_named(desktop, "Quantity") as OptionButton).item_selected.emit(2)
	_note(desktop, "cart.discount")
	var discount: Array = WorkspaceSession.evidence_for("T04")[-1]["snapshot"]["controls"].filter(func(control): return control["target"] == "cart.discount")
	check(not discount.is_empty() and discount[0]["value"] == "−$9.00", "T04 discount noted")
	_report(desktop, "Discount: −$9.00", "20% discount at every quantity")
	check_eq(GameSession.ticket_status("T04"), "RESOLVED", "T04 resolved")
	_find_record(desktop, "merge rule", "DOC-BOT-CONFIG")
	DesktopSession.open_app("messenger")
	check(press(desktop, "Open Case File and connect the clues"), "messenger sends the player to the board")
	check(find_named(desktop, "ClueBoard") != null, "clue board shown")
	_deduce(desktop, { "day": "Monday", "who": "d.reyes", "pattern": "exp/* and promo/*", "when": "02:14" }, ["CLUE-0214", "CLUE-MERGE-RULE"])
	var log := DesktopSession.messenger_log()
	check(log["entries"].any(func(entry): return entry.get("text", "") == "Chapter 1 · Release Candidate 3 complete."), "chapter 1 finale")

	_accept(desktop, "T05")
	_address(desktop, "shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	_no_issue(desktop)
	check_eq(GameSession.ticket_status("T05"), "RESOLVED", "clean build closed as NO ISSUE FOUND")
	_find_record(desktop, "access log", "DOC-ARCHIVE-ACCESS")

	_accept(desktop, "T06")
	check_eq((find_named(desktop, "Clock") as Label).text, "Fri 07:40", "the clock moves to Friday morning")
	check((find_named(desktop, "Deadline") as Label).text.contains("3h left"), "the release is hours away")
	_address(desktop, "shoply.local/product/everyday-pack")
	press(desktop, "Add to bag")
	press(desktop, "View bag")
	(find_named(desktop, "Quantity") as OptionButton).item_selected.emit(1)
	_note(desktop, "cart.shipping")
	_report(desktop, "Shipping: Free", "On every device")
	check_eq(GameSession.ticket_status("T06"), "TESTING", "desktop shipping is fine")
	DesktopSession.set_viewport("MOBILE")
	_note(desktop, "cart.shipping")
	_report(desktop, "Shipping: $5.00", "On every device")
	check_eq(GameSession.ticket_status("T06"), "RESOLVED", "T06 resolved")
	_find_record(desktop, "release/mobile-fees", "DOC-MOBILE-FEES")
	DesktopSession.open_app("messenger")
	_deduce(desktop, { "when": "23:10", "what": "a mobile shipping fee", "branch": "release/mobile-fees" })

	_accept(desktop, "T07")
	DesktopSession.set_viewport("TABLET")
	_address(desktop, "shoply.local/orders/order-1042")
	check(find_named(desktop, "CancelOrder") == null, "no Cancel order on a tablet")
	_note(desktop, "orders.cancelAction")
	_report(desktop, "Cancel action", "cancel a processing order")
	check_eq(GameSession.ticket_status("T07"), "RESOLVED", "T07 resolved")
	_find_record(desktop, "ak-7731", "DOC-API-KEYS")
	_find_record(desktop, "WS-14", "DOC-ASSET-REGISTER")
	DesktopSession.open_app("messenger")
	check(press(desktop, "Open Case File and connect the clues"), "the finale is on the board")
	_deduce(desktop, { "who": "Sam Ortiz", "where": "WS-14", "what": "exp/retention-push" }, ["CLUE-OPS-TEMP", "CLUE-MOBILE-FEES", "CLUE-WS-14"])
	log = DesktopSession.messenger_log()
	check(log["entries"].any(func(entry): return entry.get("text", "") == "Chapter 2 · Write Access complete."), "chapter 2 finale")
	check(GameSession.catalog.found_clues(GameSession.state, "CH2").size() == 3, "three chapter 2 clues")

	DesktopSession.show_case_file()
	check(find_named(desktop, "CaseFile") != null, "case file renders")
	_finish()
