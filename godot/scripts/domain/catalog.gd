## Scenario and story catalog loaded from res://data/scenarios.json
## (generated by `npm run export:godot`).
extends RefCounted

const DEFAULT_PATH := "res://data/scenarios.json"

var scenarios: Array = []
var chapters: Array = []


static func load_from(path: String = DEFAULT_PATH) -> RefCounted:
	var catalog: RefCounted = load("res://scripts/domain/catalog.gd").new()
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		push_error("Scenario catalog not found: %s" % path)
		return catalog
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("Scenario catalog is not valid JSON: %s" % path)
		return catalog
	catalog.scenarios = parsed.get("scenarios", [])
	catalog.chapters = parsed.get("chapters", [])
	return catalog


func ticket_ids() -> Array:
	return scenarios.map(func(scenario): return scenario["ticket"]["id"])


func get_scenario(ticket_id: String) -> Variant:
	for scenario in scenarios:
		if scenario["ticket"]["id"] == ticket_id:
			return scenario
	return null


func get_ticket(ticket_id: String) -> Variant:
	var scenario: Variant = get_scenario(ticket_id)
	return scenario["ticket"] if scenario != null else null


func get_chapter(chapter_id: String) -> Variant:
	for chapter in chapters:
		if chapter["id"] == chapter_id:
			return chapter
	return null


## A Ticket unlocks once every earlier Ticket in catalog order is RESOLVED.
func is_ticket_unlocked(state: Dictionary, ticket_id: String) -> bool:
	for scenario in scenarios:
		var id: String = scenario["ticket"]["id"]
		if id == ticket_id:
			return true
		if state["tickets"].get(id, {}).get("status", "") != "RESOLVED":
			return false
	return false


func find_next_open_ticket(state: Dictionary) -> Variant:
	for scenario in scenarios:
		var id: String = scenario["ticket"]["id"]
		if is_ticket_unlocked(state, id) and state["tickets"].get(id, {}).get("status", "") != "RESOLVED":
			return scenario["ticket"]
	return null


func find_clue(clue_id: String) -> Variant:
	for scenario in scenarios:
		var story: Variant = scenario.get("story", null)
		if story != null and story["clue"]["id"] == clue_id:
			return story["clue"]
	return null


## Clues the player has uncovered: the Ticket is resolved and its record, if any, was found.
func found_clues(state: Dictionary, chapter_id: String = "") -> Array:
	var result: Array = []
	for scenario in scenarios:
		var story: Variant = scenario.get("story", null)
		if story == null or (chapter_id != "" and story["chapterId"] != chapter_id):
			continue
		if is_clue_found(state, scenario):
			result.append(story["clue"])
	return result


func is_clue_found(state: Dictionary, scenario: Dictionary) -> bool:
	var story: Variant = scenario.get("story", null)
	if story == null or state["tickets"].get(scenario["ticket"]["id"], {}).get("status", "") != "RESOLVED":
		return false
	var discovery: Variant = story.get("discovery", null)
	return discovery == null or state["story"].get("foundDocuments", []).has(discovery["documentId"])


## A quiet chapter's clues stay out of the Case File until the Ticket named by
## `caseFileAfter` is resolved (canon: the Case Notes open after NW-018).
func is_case_file_open(state: Dictionary, chapter: Dictionary) -> bool:
	if not chapter.get("quiet", false):
		return true
	var after: String = chapter.get("caseFileAfter", "")
	return after != "" and state["tickets"].get(after, {}).get("status", "") == "RESOLVED"


func all_attachments() -> Array:
	var result: Array = []
	for scenario in scenarios:
		result.append_array(scenario["ticket"].get("attachments", []))
	return result
